# ── Apps Script Web App URL ──────────────────────────────────
# Setelah deploy Code.gs sebagai Web App, copy URL-nya ke sini
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# ── Secret token ─────────────────────────────────────────────
# Harus sama persis dengan CONFIG.SECRET di Code.gs
APPS_SCRIPT_SECRET=GANTI_DENGAN_TOKEN_RAHASIA_KAMU

# Expose ke browser (untuk direct fetch dari client — tidak dipakai di arsitektur ini)
# NEXT_PUBLIC_API_URL=
